/* ── Dashboard v2 · workspace KJA ─────────────────────────────────── */
:root{
  --shell:#ffffff;
  --paper:#ffffff;
  --workspace:#f5f7fa;
  --navy:#09244c;
  --navy-2:#061a38;
  --blue:#075abc;
  --cyan:#43c5d1;
  --pink:#ef0b72;
  --ink:#15243a;
  --muted:#738095;
  --line:#e3e8ee;
  --shadow-soft:0 12px 34px rgba(17,37,68,.055);
}

body{background:#fff}
.portal{
  width:100%;
  min-height:100vh;
  margin:0;
  display:grid;
  grid-template-columns:218px minmax(0,1fr) 308px;
  overflow:hidden;
  border:0;
  border-radius:0;
  background:var(--paper);
  box-shadow:none;
}

.sidebar{
  position:relative;
  inset:auto;
  width:auto;
  min-height:100%;
  padding:28px 16px 18px;
  color:#506078;
  background:#fff;
  border-right:1px solid #edf0f4;
  box-shadow:none;
}
.side-brand{height:52px;padding:0 10px;color:var(--navy)}
.side-brand img{width:39px;height:39px;border:1px solid #edf0f4;box-shadow:0 7px 18px rgba(8,35,75,.08)}
.side-brand span{font-size:15px;letter-spacing:-.02em}
.side-nav{gap:7px;margin-top:38px}
.side-nav button{
  position:relative;
  height:48px;
  padding:0 15px;
  color:#68768a;
  border-radius:11px;
  font-size:11px;
}
.side-nav button:hover{color:var(--navy);background:#f4f7fa}
.side-nav button.active{
  color:var(--navy);
  background:#eaf4ff;
  box-shadow:none;
}
.side-nav button.active:before{
  content:"";
  position:absolute;
  left:0;
  top:10px;
  bottom:10px;
  width:3px;
  border-radius:0 5px 5px 0;
  background:linear-gradient(180deg,var(--cyan),var(--blue));
}
.side-nav button.active svg{color:var(--blue)}
.side-help{
  padding:17px;
  border:0;
  border-radius:16px;
  background:linear-gradient(145deg,var(--navy-2),#123b70);
  box-shadow:0 14px 28px rgba(7,29,62,.16);
}
.side-help span{color:#86a2c4}
.side-help a{font-size:10px;font-weight:600}
.side-user{border-color:#edf0f4}
.side-user b{color:var(--navy)}
.side-user small{color:#8290a3}
.side-user button{color:#7c8b9f}
.side-user button:hover{color:var(--blue);background:#edf4fc}

.workspace{
  min-width:0;
  min-height:100%;
  margin-left:0;
  padding:34px clamp(24px,2.6vw,44px) 48px;
  background:var(--workspace);
}
.view{max-width:none}
.view-head{margin-bottom:25px}
.view-head h1{font-size:29px;letter-spacing:-.045em}
.view-head>div>p:last-child{font-size:11px}
.session-chip{background:rgba(255,255,255,.86);box-shadow:0 5px 16px rgba(20,40,70,.04)}

.today-layout{display:grid;grid-template-columns:1fr;gap:16px}
.day-card,.progress-card,.month-card,.week-strip,.calendar-card,.profile-identity,.profile-data,.team-list,.team-summary{
  border-color:#e2e7ed;
  box-shadow:var(--shadow-soft);
}
.day-card{min-height:336px;padding:25px 28px;border-radius:18px}
.day-timeline{margin:58px 0 36px}
.day-aside{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(210px,.75fr);grid-template-rows:auto;gap:16px}
.progress-card{min-height:170px;padding:21px 23px;border-radius:17px;background:#fff}
.progress-number{margin:15px 0 13px}
.progress-number strong{font-size:43px}
.progress-number small{display:inline;margin-left:8px}
.progress-card>p:last-child{margin-top:10px}
.month-card{min-height:170px;padding:22px;border-radius:17px;background:linear-gradient(145deg,#fff,#fff7fb)}
.month-icon{width:51px;height:51px;border-radius:15px}
.month-card b{font-size:30px}
.week-strip{margin-top:16px;padding:22px 25px;border-radius:18px}
.week-day{background:#fff}

/* Columna derecha: el calendario y la jornada acompañan todas las vistas. */
.portal-rail{
  min-width:0;
  padding:28px 22px 30px;
  overflow-y:auto;
  border-left:1px solid #edf0f4;
  background:#fff;
}
.rail-profile{text-align:center}
.rail-title,.rail-section-head{display:flex;align-items:center;justify-content:space-between}
.rail-title{color:var(--navy);font-size:13px;font-weight:700;text-align:left}
.rail-title button,.rail-section-head button{
  width:31px;
  height:31px;
  display:grid;
  place-items:center;
  padding:0;
  border:1px solid #e7ebf0;
  border-radius:9px;
  color:#77869a;
  background:#fff;
}
.rail-title button:hover,.rail-section-head button:hover{color:var(--blue);border-color:#bfd4eb;background:#f3f8fe}
.rail-title svg,.rail-section-head svg{width:15px}
.rail-avatar{
  width:76px;
  height:76px;
  display:grid;
  place-items:center;
  margin:21px auto 13px;
  border:6px solid #edf6ff;
  border-radius:50%;
  color:#fff;
  background:linear-gradient(145deg,var(--navy),var(--blue));
  box-shadow:0 12px 26px rgba(5,79,167,.18);
  font-size:20px;
  font-weight:800;
}
.rail-profile h2{margin:0;color:var(--navy);font-size:15px;line-height:1.35;letter-spacing:-.02em}
.rail-profile p{margin:5px 0 9px;color:#8592a3;font-size:9px}
.rail-role{display:inline-flex;padding:5px 9px;border-radius:20px;color:#0c7465;background:#e7f7f3;font-size:8px;font-weight:800}

.rail-calendar,.rail-schedule{margin-top:25px}
.rail-calendar{padding:18px 16px 15px;border:1px solid #e8ecf1;border-radius:16px;background:#fafbfc;box-shadow:0 8px 22px rgba(15,36,66,.04)}
.rail-section-head span small,.rail-section-head span b{display:block}
.rail-section-head small{color:#8b97a7;font-size:7px;font-weight:800;letter-spacing:.13em}
.rail-section-head b{margin-top:3px;color:var(--navy);font-size:12px;text-transform:capitalize}
.rail-calendar-week,.rail-calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.rail-calendar-week{margin:15px 0 5px}
.rail-calendar-week span{color:#9aa5b4;text-align:center;font-size:7px;font-weight:800}
.rail-cal-day{position:relative;min-height:28px;display:grid;place-items:center;border-radius:8px;color:#647287;font-size:8px}
.rail-cal-day b{font-weight:600}
.rail-cal-day.empty{background:transparent}
.rail-cal-day.off{color:#b6bec9}
.rail-cal-day.future{opacity:.45}
.rail-cal-day.registered{color:#08765e;background:#e7f7f2}
.rail-cal-day.registered i{position:absolute;bottom:3px;width:3px;height:3px;border-radius:50%;background:#1ba77e}
.rail-cal-day.today{color:#fff;background:var(--navy);box-shadow:0 5px 12px rgba(8,35,75,.18)}
.rail-cal-day.today i{background:#5ee0d3}
.rail-calendar-key{display:flex;gap:13px;margin-top:11px;padding-top:10px;border-top:1px solid #e8ecf1;color:#8a96a6;font-size:7px}
.rail-calendar-key span{display:flex;align-items:center;gap:5px}
.rail-calendar-key i{width:6px;height:6px;border-radius:50%;background:#25ad84}
.rail-calendar-key span:last-child i{background:var(--navy)}

.rail-schedule-list{display:grid;gap:9px;margin-top:13px}
.rail-event{
  position:relative;
  min-height:62px;
  display:grid;
  grid-template-columns:43px 1fr;
  align-items:center;
  gap:10px;
  overflow:hidden;
  padding:11px 11px 11px 15px;
  border-radius:13px;
  background:linear-gradient(100deg,#edf8fa,#f5f8fc);
}
.rail-event:before{content:"";position:absolute;inset:0 auto 0 0;width:1px;background:var(--cyan)}
.rail-event time{color:var(--navy);font-size:10px;font-weight:800}
.rail-event span b,.rail-event span small{display:block}
.rail-event span b{color:#2a3b52;font-size:9px}
