  .workspace{padding:24px 14px 40px}.admin-view-head h1{font-size:28px}
  .admin-section-nav{margin-inline:-2px}.admin-section-nav button,.admin-section-nav a{min-height:44px;padding:0 14px}
  .admin-access-toolbar,.admin-roles-toolbar{align-items:flex-start;flex-direction:column;padding:18px}
  .admin-route-card{padding:15px}.admin-route-step{min-height:0}.admin-qr-block{grid-template-columns:96px 1fr}.admin-qr-canvas{width:92px;height:92px}
  .admin-access-section-head{align-items:flex-start;flex-direction:column}.admin-access-filters{width:100%;display:grid;grid-template-columns:1fr}.admin-access-filters input,.admin-access-filters select{width:100%;min-width:0}
  .admin-access-person{grid-template-columns:38px 1fr}.access-pin-state,.access-person-action{grid-column:2}.access-person-action button{width:100%}
  .admin-role-seat{grid-template-columns:46px 1fr}.admin-role-seat>button{grid-column:2;width:100%}.admin-role-assignment{grid-template-columns:1fr}.admin-role-assignment>.admin-primary-action{width:100%}
}

/* Dashboard v3: sistema visual legible y adaptable. */
:root{
  --surface-page:#f6f8fb;
  --surface-card:#ffffff;
  --surface-subtle:#f8fafc;
  --text-strong:#09244c;
  --text-body:#34465e;
  --text-muted:#68778b;
  --line-soft:rgba(9,36,76,.10);
  --line-strong:rgba(9,36,76,.16);
  --focus:rgba(7,90,188,.24);
  --radius-card:16px;
  --radius-control:10px;
  --ease-ui:cubic-bezier(.23,1,.32,1);
  --shadow-card:0 10px 30px rgba(9,36,76,.055);
  --shadow-raised:0 18px 50px rgba(9,36,76,.10);
}

html{min-height:100%;background:var(--surface-page);scrollbar-color:#a9b6c7 #eef2f6}
body{min-height:100dvh;color:var(--text-body);background:var(--surface-page);font-size:14px;line-height:1.5}
::selection{color:#fff;background:#075abc}
*{scrollbar-width:thin;scrollbar-color:#a9b6c7 transparent}
*::-webkit-scrollbar{width:10px;height:10px}
*::-webkit-scrollbar-track{background:transparent}
*::-webkit-scrollbar-thumb{border:3px solid transparent;border-radius:999px;background:#a9b6c7;background-clip:padding-box}

.skip-link{position:fixed;z-index:1200;top:12px;left:12px;padding:10px 14px;border-radius:9px;color:#fff;background:var(--navy);font-size:13px;font-weight:700;text-decoration:none;transform:translateY(-160%);transition:transform 160ms var(--ease-ui)}
.skip-link:focus{transform:translateY(0)}
.workspace:focus{outline:none}
:where(a,button,input,select,[tabindex]):focus-visible{outline:3px solid var(--focus);outline-offset:3px}
button{transition:transform 140ms var(--ease-ui),color 160ms ease,background-color 160ms ease,border-color 160ms ease,box-shadow 160ms ease}
button:active:not(:disabled){transform:scale(.98)}
.primary:active:not(:disabled),.mark-button:active:not(:disabled),.admin-primary-action:active:not(:disabled){transform:scale(.98)}
button:disabled{cursor:not-allowed}

/* Carga: una sola señal clara, sin latido ni espera artificial. */
.boot{background:rgba(255,255,255,.25);transition:opacity 180ms ease-out,visibility 180ms ease-out;animation:none}
.boot-inner{gap:18px}
.boot-badge{width:112px;height:112px}
.boot-badge:before{border-width:3px;animation-duration:.8s}
.boot-logo{width:66px;animation:none;filter:drop-shadow(0 7px 16px rgba(9,36,76,.14))}
.boot-text{color:var(--navy);font-size:12px;letter-spacing:.16em}

/* Armazón del producto. */
.portal{grid-template-columns:236px minmax(0,1fr) 330px;min-height:100dvh;color:var(--text-body);background:var(--surface-page)}
.portal.admin-wide{grid-template-columns:236px minmax(0,1fr)}
.sidebar{padding:28px 18px 20px;border-right:1px solid var(--line-soft)}
.side-brand{padding-inline:8px}
.side-brand span{font-size:16px}
.side-nav{gap:5px;margin-top:34px}
.side-nav-divider{margin:24px 14px 6px;color:#7f8da0;font-size:10px;letter-spacing:.11em}
.side-nav button{min-height:48px;height:auto;padding:12px 14px;border-radius:var(--radius-control);font-size:13px;line-height:1.35}
.side-nav button svg{width:20px;height:20px;flex:0 0 auto}
.side-nav button.active{background:#edf5ff;box-shadow:inset 3px 0 0 #168c98}
.side-help{padding:18px;border-radius:var(--radius-card);box-shadow:0 12px 30px rgba(7,29,62,.14)}
.side-help span{margin-bottom:7px;font-size:10px}
.side-help a{font-size:12px;line-height:1.45;text-decoration:underline;text-decoration-color:rgba(255,255,255,.28);text-underline-offset:3px}
.side-user{grid-template-columns:40px minmax(0,1fr) 36px;gap:10px}
.side-user b{font-size:12px}.side-user small{font-size:11px}.side-user button{width:36px;height:36px}

.workspace{min-height:100dvh;padding:36px clamp(26px,2.7vw,48px) 56px;background:linear-gradient(180deg,#f8fafc 0%,var(--surface-page) 42%)}
.view{width:100%;max-width:1440px}
.view-head{gap:24px;margin-bottom:28px}
.view-head h1{max-width:22ch;color:var(--text-strong);font-size:clamp(30px,2.1vw,38px);line-height:1.12;letter-spacing:-.035em;text-wrap:balance}
.view-head>div>p:last-child{max-width:70ch;margin-top:8px;color:var(--text-muted);font-size:14px;line-height:1.6}
.eyebrow{margin-bottom:8px;color:#087d88;font-size:10px;line-height:1.4;letter-spacing:.14em}
.session-chip{min-height:38px;padding:9px 13px;border:1px solid var(--line-soft);color:#52647b;font-size:11px;white-space:nowrap;box-shadow:none}

/* Inicio personal. */
.today-layout{gap:18px}
.day-card,.progress-card,.month-card,.week-strip,.calendar-card,.profile-identity,.profile-data,.team-list,.team-summary{border:1px solid var(--line-soft);border-radius:var(--radius-card);background:var(--surface-card);box-shadow:var(--shadow-card)}
.day-card{min-height:350px;padding:28px 30px}
.day-card-head small,.time-label small{font-size:10px;letter-spacing:.1em}
.day-card-head b{font-size:17px}
.status-pill{padding:7px 11px;font-size:10px}
.day-timeline{margin:60px 0 38px}
.time-label b{font-size:22px}
.day-context{gap:8px}.day-context span{padding:7px 10px;font-size:10px}
.day-action{padding-top:20px}
.mark-button{min-height:48px;border-radius:11px;font-size:13px}
.day-action p{font-size:11px;line-height:1.55}

.day-aside{gap:18px}
.progress-card,.month-card{min-height:174px;padding:23px 24px}
.progress-number strong{font-size:46px;letter-spacing:-.04em}
.progress-number span{font-size:18px}
.progress-number small,.progress-card>p:last-child{color:var(--text-muted);font-size:11px}
.progress-track{height:6px;background:rgba(9,36,76,.10)}
.progress-track i{transform:scaleX(0);transform-origin:left center;transition:transform 260ms var(--ease-ui)}
.month-card{background:#fff}
.month-card small{font-size:10px}.month-card b{font-size:32px}.month-card em{margin-top:3px;font-size:10px}
.month-icon{width:50px;height:50px;border-radius:14px;box-shadow:0 9px 22px rgba(239,11,114,.16)}

/* Centro de marcado: horario, acción y avance en una sola composición. */
.today-layout .day-card{min-height:0;padding:0;overflow:hidden}
.day-card-head{min-height:78px;padding:20px 28px}
.day-card-grid{display:grid;grid-template-columns:minmax(0,1.48fr) minmax(280px,.72fr);border-top:0}
.day-schedule{min-width:0;padding:26px 28px 24px}
.day-section-heading{display:flex;align-items:center;gap:12px}
.day-section-heading>span:last-child small,.day-section-heading>span:last-child b{display:block}
.day-section-heading small,.day-action-copy>small{color:#7d8da2;font-size:9px;font-weight:800;letter-spacing:.12em}
.day-section-heading b{margin-top:3px;color:var(--navy);font-size:15px}
.day-section-icon,.day-action-icon,.summary-icon{display:grid;place-items:center;flex:0 0 auto;color:#0a67be;background:#edf6ff}
.day-section-icon{width:40px;height:40px;border-radius:12px}
.day-section-icon svg,.day-action-icon svg,.summary-icon svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.day-schedule .day-timeline{grid-template-columns:76px minmax(0,1fr) 76px;margin:37px 0 32px}
.day-schedule .day-context{margin:0}
.day-schedule .day-context span{border:1px solid #e4eaf1;background:#f6f8fb}
.day-card-grid .day-action{display:flex;flex-direction:column;align-items:flex-start;gap:0;min-width:0;padding:26px;border:0;background:rgba(244,248,252,.68)}
.day-action-icon{width:48px;height:48px;border-radius:15px;color:#087d88;background:#e5f7f5}
.day-action-icon svg{width:24px;height:24px}
.day-action-copy{margin-top:22px}
.day-action-copy h2{max-width:17ch;margin:7px 0 8px;color:var(--navy);font-size:21px;line-height:1.18;letter-spacing:-.025em;text-wrap:balance}
.day-card-grid .day-action p{max-width:34ch;color:#718197;font-size:11px;line-height:1.55}
.day-card-grid .mark-button{width:100%;margin-top:auto;padding-inline:16px}
.day-card[data-attendance-state="marked"] .day-action-icon{color:#08785f;background:#e4f7f1}
.day-card[data-attendance-state="late"] .day-action-icon{color:#9b5c00;background:#fff0d6}
.day-card[data-attendance-state="closed"] .day-action-icon,.day-card[data-attendance-state="off"] .day-action-icon{color:#a4374a;background:#ffe9ed}
.day-card[data-attendance-state="closed"] #now-marker,.day-card[data-attendance-state="off"] #now-marker{visibility:hidden}
.day-card[data-attendance-state="marked"] .mark-button:disabled{color:#08785f;background:#dff3ed}
.day-card[data-attendance-state="closed"] .mark-button:disabled,.day-card[data-attendance-state="off"] .mark-button:disabled,.day-card[data-attendance-state="before"] .mark-button:disabled{color:#607188;background:#e4eaf1}

.day-summary{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);border-top:0;background:rgba(255,255,255,.42)}
.day-summary .progress-card,.day-summary .month-card{min-height:118px;border:0;border-radius:0;background:transparent;box-shadow:none}
.day-summary .progress-card{display:grid;grid-template-columns:46px minmax(0,1fr);grid-template-rows:auto auto;align-items:center;column-gap:15px;padding:22px 28px}
.summary-icon{grid-row:1;width:46px;height:46px;border-radius:14px;color:#0a67be;background:#edf6ff}
.summary-copy{min-width:0}
.summary-copy .eyebrow{margin:0 0 5px;font-size:9px}
.day-summary .progress-number{display:flex;align-items:baseline;gap:3px;margin:0}
.day-summary .progress-number strong{font-size:30px;letter-spacing:-.045em}
.day-summary .progress-number>span{font-size:15px}
.day-summary .progress-number small{display:inline;margin:0 0 0 7px;font-size:10px}
.day-summary .summary-copy>p:last-child{margin:4px 0 0;color:var(--text-muted);font-size:10px;line-height:1.4}
.day-summary .progress-track{grid-column:2;height:5px;margin-top:11px}
.day-summary .month-card{padding:22px 28px;border-left:0}
.day-summary .month-icon{width:46px;height:46px;border-radius:14px;box-shadow:none}
.day-summary .month-card b{font-size:28px}
.day-summary .month-card em{font-size:10px;line-height:1.45}

.week-strip{margin-top:18px;padding:24px 26px}
.section-title h2{font-size:20px;letter-spacing:-.02em}
.section-title button{min-height:38px;padding:0 4px;font-size:12px}
.week-days{gap:10px;margin-top:20px}
.week-day{min-height:88px;border-color:var(--line-soft);border-radius:12px;background:#fff}
.week-day small{font-size:10px}.week-day b{font-size:16px}.week-day i{width:6px;height:6px}
.week-day.today{border-color:rgba(7,90,188,.34);background:#f0f6fd;box-shadow:inset 0 0 0 1px rgba(7,90,188,.06)}

/* Columna de contexto personal. */
.portal-rail{padding:30px 24px;border-left:1px solid var(--line-soft);background:#fff}
.rail-title{font-size:14px}.rail-title button,.rail-section-head button{width:36px;height:36px;border-color:var(--line-soft);border-radius:10px}
.rail-avatar{width:80px;height:80px;margin:22px auto 14px;border-width:5px;font-size:21px}
.rail-profile h2{font-size:16px}.rail-profile p{font-size:11px}.rail-role{padding:6px 10px;font-size:10px}
.rail-calendar,.rail-schedule{margin-top:27px}
.rail-calendar{padding:19px 17px 16px;border-color:var(--line-soft);border-radius:var(--radius-card);background:var(--surface-subtle);box-shadow:none}
.rail-section-head small{font-size:10px}.rail-section-head b{font-size:13px}
.rail-calendar-week span{font-size:10px}
.rail-cal-day{min-height:31px;font-size:10px}
.rail-calendar-key{font-size:10px}
.rail-schedule-list{gap:10px}
.rail-event{min-height:68px;grid-template-columns:48px 1fr;padding:12px 12px 12px 16px;border-radius:12px}
.rail-event time{font-size:11px}.rail-event span b{font-size:11px}.rail-event span small{font-size:10px}
.rail-empty{font-size:10px;line-height:1.5}
.rail-insight{padding:16px;border-radius:var(--radius-card);box-shadow:0 12px 28px rgba(9,36,76,.15)}
.rail-insight small{font-size:10px}.rail-insight b{font-size:22px}.rail-insight em{font-size:10px}

/* Historial, perfil y equipo. */
.month-toolbar{gap:8px}.month-toolbar button{width:40px;height:40px}.month-toolbar b{font-size:14px}
.attendance-stats{gap:12px}.att-stat{padding:18px;border:1px solid var(--line-soft);box-shadow:none}.att-stat small{font-size:10px}.att-stat b{font-size:26px}
.calendar-card{padding:24px}.calendar-week span{font-size:10px}.cal-day{min-height:72px;border-radius:11px}.cal-day b{font-size:12px}.cal-day i{font-size:9px}.calendar-legend{font-size:11px}
.profile-layout{grid-template-columns:minmax(250px,300px) minmax(0,1fr);gap:22px}
.profile-identity{padding:34px 26px;background:#fff}.profile-identity h2{font-size:21px}.profile-identity p{font-size:13px}.profile-badge{font-size:11px}
.profile-data{padding:30px}.profile-field small{font-size:10px}.profile-field b{font-size:14px}.profile-notice span{font-size:11px}.profile-notice span b{font-size:12px}.profile-notice a{font-size:11px}
.team-kpi{padding:22px}.team-kpi small{font-size:10px}.team-kpi b{font-size:28px}
.team-row{min-height:70px;grid-template-columns:44px minmax(190px,1fr) minmax(130px,.7fr) 110px 92px;padding:14px 18px}
.team-row strong{font-size:13px}.team-row small{font-size:11px}.team-state{font-size:10px}.team-profile-open{min-height:38px;padding-inline:11px;font-size:10px}

/* Administración: la densidad se mantiene, la lectura no se sacrifica. */
.admin-view{--admin-caption:11px;--admin-small:clamp(12px,.15vw + 10px,13px);--admin-body:clamp(13px,.16vw + 10px,14px);--admin-title:clamp(19px,.35vw + 15px,23px)}
.admin-section-nav{padding:4px;border:1px solid var(--line-soft);border-radius:13px;background:#fff;box-shadow:0 7px 22px rgba(9,36,76,.04)}
.admin-section-nav button,.admin-section-nav a{border-radius:9px}
.admin-section-nav button.active{box-shadow:0 5px 14px rgba(9,36,76,.14)}
.admin-kpi,.admin-panel,.admin-module,.admin-list-kpi,.admin-area-group,.admin-people-group,.admin-person-card,.admin-contract-row,.admin-summary-hero article,.admin-summary-table,.admin-month-ledger,.admin-route-card,.admin-policy-card,.admin-access-requests,.admin-access-directory,.admin-access-audit,.admin-role-area,.admin-roles-audit{border-color:var(--line-soft);border-radius:var(--radius-card);box-shadow:var(--shadow-card)}
.admin-kpi:after{opacity:.55}
.admin-module{border-radius:14px}
.admin-refresh,.admin-primary-action,.admin-secondary-action,.admin-date-control button,.admin-month-picker button{border-radius:var(--radius-control)}
.admin-refresh:disabled{opacity:.65}
.admin-section-nav,.admin-month-ledger,.admin-summary-table{scrollbar-color:#9eacbe transparent}

/* Formularios y modales. */
input,select{color:var(--text-body)}
input::placeholder{color:#748297;opacity:1}
.field label{font-size:12px}.field-box{min-height:52px;border-color:var(--line-strong);border-radius:11px}.field-box input{font-size:14px}.reveal{font-size:11px}
.primary{min-height:52px;border-radius:11px;font-size:13px}
.form-note{font-size:10px;line-height:1.55}
.form-msg,.mark-msg{font-size:12px;line-height:1.55}
.modal-backdrop{background:rgba(5,20,42,.48);backdrop-filter:blur(8px)}
.mark-sheet,.admin-editor-sheet,.admin-month-sheet,.team-profile-sheet{border:1px solid rgba(255,255,255,.6);box-shadow:var(--shadow-raised)}
.mark-sheet>p{font-size:12px;line-height:1.6}.privacy-note{font-size:11px!important;line-height:1.6}
.evidence-empty b{font-size:14px}.evidence-empty p{font-size:11px}.evidence-empty button{min-height:40px;font-size:11px}
.team-profile-sheet{width:min(680px,100%)}
.team-profile-head>span:last-child>p:last-child{font-size:11px}
.team-profile-facts small,.team-profile-week span,.team-profile-stats small{font-size:10px}
.team-profile-facts b{font-size:12px}.team-profile-month>header small{font-size:10px}.team-profile-month>header b{font-size:14px}.team-profile-month>header strong{font-size:21px}
.team-profile-calendar span,.team-profile-calendar span b{font-size:10px}.team-profile-calendar span i{font-size:9px}.team-profile-privacy{font-size:10px;line-height:1.55}
.admin-editor-head>div>p:last-child,.admin-editor-label span{font-size:12px!important}.admin-editor-label b{font-size:14px}.admin-field{font-size:11px!important}.admin-editor-foot button{min-height:42px}
.admin-editor-modal,.admin-month-modal{font-size:13px}
.admin-editor-sheet small,.admin-month-sheet small{font-size:11px!important;line-height:1.5}
.admin-editor-sheet p,.admin-month-sheet p{font-size:12px;line-height:1.55}
.admin-editor-sheet label,.admin-month-sheet label{font-size:11px!important}
.admin-editor-sheet input,.admin-editor-sheet select,.admin-editor-sheet button:not(.modal-close),.admin-month-sheet input,.admin-month-sheet select,.admin-month-sheet button:not(.modal-close){font-size:12px!important}
.admin-editor-sheet input,.admin-editor-sheet select,.admin-month-sheet input,.admin-month-sheet select{min-height:40px}
.admin-pending-check b,.admin-schedule-row>b,.admin-history-list b{font-size:12px!important}
.admin-schedule-head{font-size:10px}

@media(hover:hover) and (pointer:fine){
  .week-day,.admin-module,.team-profile-open,.rail-title button,.rail-section-head button{transition:transform 160ms var(--ease-ui),border-color 160ms ease,background-color 160ms ease,box-shadow 160ms ease}
  .week-day:hover,.admin-module:hover{transform:translateY(-2px);border-color:var(--line-strong);box-shadow:0 12px 28px rgba(9,36,76,.08)}
}

@media(max-width:1280px){
  .portal{grid-template-columns:228px minmax(0,1fr)}
  .portal.admin-wide{grid-template-columns:228px minmax(0,1fr)}
  .portal-rail{display:none}
  .workspace{padding-inline:clamp(24px,3.2vw,42px)}
}

@media(max-width:900px){
  .portal,.portal.admin-wide{display:block;min-height:100dvh}
  .mobile-head{height:68px;border-color:var(--line-soft);background:rgba(255,255,255,.94)}
  .sidebar{width:min(286px,86vw);min-height:100dvh;padding-top:24px}
  .workspace{min-height:calc(100dvh - 68px);padding:28px 20px 48px}
  .view-head h1{font-size:clamp(28px,6vw,34px)}
  .today-layout,.day-aside,.profile-layout{grid-template-columns:1fr}
  .day-card-grid{grid-template-columns:1fr}
  .day-card-grid .day-action{min-height:245px;border:0}
  .day-summary{grid-template-columns:minmax(0,1.15fr) minmax(230px,.85fr)}
  .admin-head-actions{width:100%;justify-content:space-between}
}

@media(max-width:650px){
  body{font-size:13px}
  .workspace{padding:24px 14px 42px}
  .view-head{margin-bottom:22px}.view-head>div>p:last-child{font-size:13px}
  .session-chip{margin-top:14px}
  .day-card{padding:22px 18px}.day-timeline{grid-template-columns:62px minmax(0,1fr) 62px;margin:54px 0 34px}.time-label b{font-size:18px}
  .today-layout .day-card{padding:0}
  .day-card-head{min-height:68px;padding:17px 18px}
  .day-schedule{padding:22px 18px}
  .day-schedule .day-timeline{grid-template-columns:62px minmax(0,1fr) 62px;margin:34px 0 30px}
  .day-card-grid .day-action{min-height:232px;padding:22px 18px}
  .day-action-copy{margin-top:18px}.day-action-copy h2{font-size:19px}
  .day-summary{grid-template-columns:1fr}
  .day-summary .progress-card,.day-summary .month-card{min-height:108px;padding:20px 18px}
  .day-summary .month-card{border:0}
  .day-aside{gap:12px}.progress-card,.month-card{min-height:0;padding:20px}
  .week-strip{padding:20px 16px}.week-days{grid-template-columns:repeat(7,minmax(42px,1fr));overflow-x:auto;padding-bottom:5px}.week-day{min-height:74px}
  .section-title{align-items:flex-start;gap:12px}.section-title h2{font-size:18px}
  .calendar-card{padding:16px 10px}.cal-day{min-height:58px;padding:7px 5px}.calendar-legend{gap:10px}
  .profile-data{padding:22px 16px}.profile-notice{grid-template-columns:30px 1fr!important}.profile-notice a{grid-column:2}
