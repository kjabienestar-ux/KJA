      <header class="view-head">
        <div><p class="eyebrow" id="today-label">TU JORNADA</p><h1 id="welcome">Buenos días</h1><p id="welcome-sub">Aquí tienes lo importante de hoy.</p></div>
        <span class="session-chip"><i></i>Sesión segura · <b id="session-left">8 h</b></span>
      </header>

      <div class="today-layout">
        <article class="day-card" id="today-attendance-card" data-attendance-state="loading">
