          <div class="profile-photo-actions">
            <input id="profile-photo-input" type="file" accept="image/jpeg,image/png,image/webp" hidden>
            <button class="profile-photo-change" id="profile-photo-change" type="button">Subir foto</button>
            <button class="profile-photo-remove" id="profile-photo-remove" type="button" hidden>Quitar</button>
