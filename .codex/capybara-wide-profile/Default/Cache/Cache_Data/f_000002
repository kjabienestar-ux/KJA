                <small>ESTADO DEL MARCADO</small>
                <h2 id="attendance-state-title">Preparando tu jornada</h2>
                <p id="mark-help">La hora se registra directamente desde el servidor.</p>
              </div>
              <button class="mark-button" id="open-mark"><span id="mark-label">Marcar mi asistencia</span><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></button>
            </section>
          </div>

          <div class="day-summary" aria-label="Resumen del mes">
