            <span class="mobile-session-state"><i></i>Sesión segura</span>
          </div>
          <nav class="mobile-quick-grid" aria-label="Accesos rápidos">
            <button type="button" data-mobile-action="asistencia">
              <img class="card-deco-3d" src="images/dashboard/marcar-3d.webp" alt="" aria-hidden="true">

              <span><b>Mi asistencia</b><small>Historial y calendario</small></span>
              <svg class="mobile-action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
