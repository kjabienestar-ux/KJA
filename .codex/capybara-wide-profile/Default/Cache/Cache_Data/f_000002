            </button>
            <button type="button" data-mobile-action="equipo" id="mobile-action-team" hidden>
              <svg class="card-deco-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c.5-3.6 2.5-5 6-5s5.5 1.4 6 5M15 15c3.6 0 5.5 1.4 6 4"/></svg>

              <span><b>Mi equipo</b><small>Personas de mi área</small></span>
              <svg class="mobile-action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
            <button type="button" data-mobile-action="gestion" id="mobile-action-admin" hidden>
              <svg class="card-deco-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5M16 4v5M8 14h3M14 14h2M8 17h8"/></svg>

              <span><b>Gestión</b><small>Panel administrativo</small></span>
              <svg class="mobile-action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </nav>


          <article class="mobile-today-summary" id="mobile-today-summary" tabindex="-1">
