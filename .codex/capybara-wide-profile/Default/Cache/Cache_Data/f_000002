      <div class="profile-layout">
        <article class="profile-identity">
          <div class="profile-photo-wrap">
            <span class="profile-avatar" id="profile-avatar">KJ</span>
            <button class="profile-photo-camera" id="profile-photo-camera" type="button" aria-label="Cambiar foto de perfil" title="Cambiar foto">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
            </button>
          </div>
